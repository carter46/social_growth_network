APP_NAME="Social Growth Network"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
# Must include https:// — never APP_URL=yourdomain.com (breaks media img src on nested admin routes)
# Optional override for public disk base (default root-relative /storage):
# FILESYSTEM_PUBLIC_URL=/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Demo data (separate from APP_ENV — safe for pre-launch production)
# ALLOW_DEMO_DATA=true enables demo:seed / DemoPlatformSeeder even when APP_ENV=production
# ALLOW_DESTRUCTIVE_SEEDERS=true required for demo:fresh wipe when APP_ENV=production
# Launch day: ALLOW_DEMO_DATA=true → php artisan demo:clear --force → set ALLOW_DEMO_DATA=false
ALLOW_DEMO_DATA=false
ALLOW_DESTRUCTIVE_SEEDERS=false
# Alias (same as ALLOW_DEMO_DATA):
SEED_DEMO_DATA=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=7th_trade_hub
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: true. Local http://127.0.0.1 dev: false (or leave unset).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_MAX_UPLOAD_KB=2048
MEDIA_KEEP_ORIGINAL=false
MEDIA_DOCUMENTS_DISK=local
MEDIA_DOCUMENTS_MAX_UPLOAD_KB=5120
# Monnify webhooks require an async queue in production (database or redis) plus
# `php artisan queue:work` (or a supervisor). Use sync only for local/dev without workers —
# sync processes jobs inline and is not safe for live webhook/payout flows.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

WALLET_PROVIDER=manual

# Platform catalog: prefer DB service_categories / product_types when populated
CATALOG_USE_DB_HIERARCHY=true

# Optional legal contact shown on /legal
# LEGAL_CONTACT_EMAIL=legal@yourdomain.com

# Production admin (php artisan db:seed --class=ProductionSeeder)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# ADMIN_USERNAME=admin

# Optional error monitoring (composer require sentry/sentry-laravel)
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2

# Optional Slack alerts for critical errors
# LOG_SLACK_WEBHOOK_URL=

# Comma-separated proxy IPs (Cloudflare, load balancer). Leave empty if not behind a proxy.
# TRUSTED_PROXIES=
